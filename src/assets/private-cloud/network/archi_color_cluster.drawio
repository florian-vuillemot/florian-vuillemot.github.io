  <diagram name="2 - Subnet Differentiation &amp; Future Policy" id="page2">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1920" pageHeight="1080">
      <root>
