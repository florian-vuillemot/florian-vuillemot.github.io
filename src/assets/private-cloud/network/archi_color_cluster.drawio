        <mxCell id="1" parent="0" />
        <mxCell id="200" value="Subnet Zones (Diff) &amp; Policy Roadmap Current: ALLOW ANY between zones • Future: Default‑deny + explicit allows" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="1800" height="80" as="geometry" />
