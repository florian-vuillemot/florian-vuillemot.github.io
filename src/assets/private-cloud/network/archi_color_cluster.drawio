        <mxCell id="210" value="HQ‑Users (Corp LAN) CIDR: 192.168.42.0/24 GW: 192.168.42.1 Notes: User endpoints, printers" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor:#4b89dc;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="211" value="HQ‑VPN‑Clients (WG) CIDR: 192.168.43.0/24 GW: 192.168.43.1 Notes: Remote users via WireGuard" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor:#2fab5a;" vertex="1" parent="1">
          <mxGeometry x="520" y="160" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="212" value="HQ‑Dev VLAN CIDR: 192.168.44.0/24 GW: 192.168.44.1 Notes: Dev/test workloads" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor:#ff9800;" vertex="1" parent="1">
          <mxGeometry x="980" y="160" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="213" value="HQ‑Prod VLAN CIDR: 192.168.45.0/24 GW: 192.168.45.1 Notes: Production systems" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor:#d32f2f;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="214" value="STM‑Users (Site LAN) CIDR: 192.168.50.0/24 GW: 192.168.50.1 Notes: Branch endpoints" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor:#8e44ad;" vertex="1" parent="1">
          <mxGeometry x="520" y="360" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="215" value="P2P Link (/31) CIDR: 192.168.80.0/31 GW: HQ .0 • STM .1 Notes: Intersite routed link" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor:#d6b656;" vertex="1" parent="1">
          <mxGeometry x="980" y="360" width="420" height="160" as="geometry" />
        </mxCell>
        <mxCell id="260" value="Policy Roadmap 1) Define firewall aliases per zone and FQDNs (e.g., *.standard-cloud.io) 2) Switch to default‑deny between all zones 3) Allow minimal flows:    • Users→Prod: RDP/HTTPS as needed    • Dev↔Prod: CI/CD ports only    • VPN‑Clients→*: least privilege 4) STM→HQ static + policy route: 192.168.0.0/16 &amp; *.standard-cloud.io via HQ 5) Enable logging; review &amp; tighten monthly" style="shape=note;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="860" height="240" as="geometry" />
        </mxCell>
        <mxCell id="261" value="Routing Summary • Static routes between HQ and STM • P2P /31 192.168.80.0/31 (HQ .0, STM .1) • NAT on both edges • DNS Resolver + DHCP on pfSense at each site • No IPv6 at this time" style="shape=note;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="980" y="540" width="880" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
